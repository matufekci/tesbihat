{
  "name": "tesbihat",
  "private": true,
  "version": "1.22.0",
  "type": "module",
  "description": "Ruhi Tesbihat — beş vaktin ardından okunan zikir, salavât, dua ve sureler; her vakit için sayaçlı rehber",
  "scripts": {
    "dev": "vite",
    "test": "node --test",
    "lint": "eslint .",
    "build": "vite build && node scripts/write-sw.js",

    "@fontsource/scheherazade-new": "^5.3.0",
    "flag-icons": "^7.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "vite": "^7.3.8"
  }

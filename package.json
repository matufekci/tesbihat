    "apk:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.0",
